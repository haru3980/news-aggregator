# このファイルを .env にコピーして、実際の値を入力してください
# .env は絶対にGitにコミットしないこと(.gitignoreに入れてあります)

# Supabase (Settings > API から取得)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=xxxxxxxxxxxxxxxxxxxx

# Gemini API (https://aistudio.google.com/apikey から取得・無料枠あり)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx

# NewsData.io (https://newsdata.io から取得・無料枠あり)
NEWSDATA_API_KEY=xxxxxxxxxxxxxxxxxxxx
